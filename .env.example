# Copy to .env and replace every secret. Never commit the copy.
# The API refuses production startup when AUTH_MODE is not oidc, cookies are not secure, or these placeholders remain.

# development | production
ENVIRONMENT=development

# Authoritative application database. The browser never uses this URL.
DATABASE_URL=postgres://sdn:sdn@127.0.0.1:5432/sdn?sslmode=disable

HTTP_ADDR=:8080

# dev enables the embedded identity provider and password login.
# production requires oidc and an external issuer.
AUTH_MODE=dev

# Signs preview tokens and session material. Use a long random value.
TOKEN_SECRET=replace-me

# External issuer used when AUTH_MODE=oidc. Ignored by the embedded development provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=sdn-web
OIDC_CLIENT_SECRET=replace-me

# Browser origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:5173

# Must match the frontend callback exactly.
OIDC_REDIRECT_URLS=http://localhost:5173/callback

# Public base the API advertises in OIDC discovery.
PUBLIC_API_BASE=http://localhost:8080

# true in production. Required when COOKIE_SAMESITE=none.
SECURE_COOKIES=false

# lax when the UI is served from the same site as the API.
# none when Vercel and the API are different sites. none requires SECURE_COOKIES=true.
COOKIE_SAMESITE=lax

# true runs approved changes inside the API process. Set false when services/worker is running.
INLINE_WORKFLOWS=true

# memory is the local default and is refused in production.
# file stores values under SECRET_FILE_DIR and is also refused in production.
# vault is a KV v2 HTTP client. Production requires vault, VAULT_ADDR, and VAULT_TOKEN.
SECRET_BACKEND=memory
SECRET_FILE_DIR=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret

# Empty means the PostgreSQL worker is the workflow driver. A value dials that
# Temporal frontend. This repository does not start a Temporal cluster.
# Production refuses INLINE_WORKFLOWS=true together with TEMPORAL_ADDRESS.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default

# Used only by `go run ./services/api/cmd/api seed`. Not a production password.
DEV_ADMIN_PASSWORD=

# Site agent. The token is shown once at enrollment and is not a user password.
# SDN_API_URL=http://127.0.0.1:8080
# SDN_AGENT_TOKEN=
# SDN_SITE_NAME=
