FROM golang:1.26.9-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/sdn-connector ./connectors/site-agent

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates iputils-ping && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/sdn-connector /usr/local/bin/sdn-connector
USER nobody
ENTRYPOINT ["sdn-connector"]
