# Variable names read by connectors/site-agent and deploy/connector-compose.yml.
# Export them in the shell before compose, or place the same keys in /etc/sdn/connector.env
# for the Linux systemd unit. This file is not loaded automatically.

# API origin the connector dials. TLS certificates are validated.
SDN_API_URL=https://the-api-origin

# One-time enrollment token from the console. Expires in 15 minutes. Leave empty after enrollment.
SDN_ENROLLMENT_TOKEN=

# Stored credential. Empty on first start. The process writes it to SDN_AGENT_STATE.
SDN_AGENT_TOKEN=

# Compose sets this path. The systemd unit uses the same path.
SDN_AGENT_STATE=/var/lib/sdn-connector/credential
